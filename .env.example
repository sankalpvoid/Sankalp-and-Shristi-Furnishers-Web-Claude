# Copy to .env.local and fill in. NEVER commit real values.

# Admin sign-in (required to use /admin). Choose a long, unique password.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-before-use

# Random string (32+ chars) used to sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Optional: where the SQLite database + uploads live (default ./data)
# DATA_DIR=./data

# Public site URL used for share links (default: derived from request)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
